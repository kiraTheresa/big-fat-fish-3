# OneBot 11 正向 WebSocket 地址（Bot 主动连接 NapCat）
ONEBOT_WS_URL=ws://localhost:3001

# OneBot 访问令牌，留空则不校验（需与 NapCat WebUI 网络配置保持一致）
ONEBOT_ACCESS_TOKEN=

# DeepSeek API Key（AIChat 触发器；留空 = chat 触发器不生效）
DEEPSEEK_API_KEY=

# DeepSeek 接口（可选，OpenAI 兼容；默认 https://api.deepseek.com / deepseek-chat）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# AIChat 行为（可选）：LLM 超时 ms / 携带历史条数 / 会话冷却 ms
CHAT_TIMEOUT_MS=60000
CHAT_CONTEXT_LINES=20
CHAT_COOLDOWN_MS=5000
