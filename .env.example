# NapCat：首次扫码的 QQ 号；填入后重启会尝试快速登录（会话失效仍需扫码）
NAPCAT_ACCOUNT=
# 固定 Linux 主机名；已有部署应沿用原 hostname，之后不要随意更改
NAPCAT_HOSTNAME=fish-qq

# OneBot 11 正向 WebSocket 地址（Bot 主动连接 NapCat）
ONEBOT_WS_URL=ws://localhost:3001

# OneBot 访问令牌；Compose 必填，启动时自动同步到 NapCat 的 3001 WS 服务
# 可用 openssl rand -hex 32 生成；本地 mock 开发可留空
ONEBOT_ACCESS_TOKEN=

# 连接与发送（ms）；发送队列在每次 API 调用结束后等待此间隔
RECONNECT_DELAY_MS=5000
API_TIMEOUT_MS=15000
SEND_INTERVAL_MS=1000

# 消息、会话状态及 media 原图/表情包目录；PERSONA_DIR、USAGE_DIR 可独立配置
DATA_DIR=data

# DeepSeek API Key（AIChat 触发器；留空 = chat 触发器不生效）
DEEPSEEK_API_KEY=

# DeepSeek 接口（可选，OpenAI 兼容；文字、识图与记忆提炼共用 deepseek-flash）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# AIChat 行为（可选）：LLM 超时 ms / 携带历史条数 / 会话冷却 ms
CHAT_TIMEOUT_MS=60000
# 对话/识图流式接收；不支持 stream 的中转设为 false（需重启）。
CHAT_STREAM=true
CHAT_CONTEXT_LINES=20
CHAT_COOLDOWN_MS=2000

# 识图：与聊天共用模型、Key 和 Base URL；通过 Prompt 的「本轮图片理解」开关关闭
# 每次一张，支持纯图消息；群聊和私聊近图窗口 ms / 图片下载超时 ms
VISION_IMAGE_WINDOW_MS=120000
VISION_FETCH_TIMEOUT_MS=30000

# 绘图：Key 留空则禁用；以下为代码当前默认值，上游需支持相应接口与模型
IMAGE_API_KEY=
IMAGE_API_BASE_URL=https://api2.laozhang.ai/v1
IMAGE_MODEL=gpt-image-2.5-flare-vip
IMAGE_SIZE=2K
IMAGE_TIMEOUT_MS=120000

# 管理员 QQ 白名单（逗号分隔，如 123,456，跨群统一；留空 = 群聊管理指令全拒，私聊不受影响）
ADMIN_QQ=

# 自进化人设（可选）：人设文件根目录 / character.md、memory.md 单文件字节上限
PERSONA_DIR=data/personas
PERSONA_MAX_BYTES=4096

# 离线提炼双条件（静默或批量，先到先触发）：会话静默 ms / 水位后新增消息条数 / 调度器扫描间隔 ms
DISTILL_SILENCE_MS=600000
DISTILL_BATCH_SIZE=50
DISTILL_INTERVAL_MS=300000
# 群聊无人调用后的记忆提炼休眠时间（ms），普通闲聊不会续期
DISTILL_IDLE_MS=7200000

# LLM 用量 JSONL 落盘根目录
USAGE_DIR=data/usage

# 行为开关 JSON 路径（模板见 config.example.json）
# 文件缺失静默用默认值；读取/JSON 解析失败或顶层非对象时 WARN 并回退默认值
# 配置启动时读取：修改 .env 或 config.json 后需重启 Bot
CONFIG_PATH=./config.json

# 管理网站：设置至少 24 字符的随机令牌后启动；留空则只运行 Bot。
# 用 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" 生成，勿共享。
ADMIN_TOKEN=
ADMIN_HOST=127.0.0.1
ADMIN_PORT=3210
# 结构化日志级别 INFO/WARN/ERROR；观察事件与日志按天存放，默认保留 30 天。
LOG_LEVEL=INFO
RETENTION_DAYS=30
