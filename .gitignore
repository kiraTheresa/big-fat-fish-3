# ===== .gitignore 占位 =====
# 项目技术栈确定后，可按需补充具体规则

# ---- 操作系统 ----
.DS_Store
Thumbs.db
Desktop.ini

# ---- 编辑器 / IDE ----
.idea/
.vscode/
*.swp
*.swo

# ---- 日志与临时文件 ----
*.log
tmp/
temp/

# ---- Node ----
node_modules/

# ---- 运行时数据 ----
data/

# ---- NapCat 挂卷（QQ 登录态与配置）----
napcat/

# ---- 环境与密钥（勿提交敏感信息）----
.env
.env.local
*.pem
